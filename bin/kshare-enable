#!/bin/sh
dest="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/kshare.screen"
mkdir -p "$(dirname "$dest")"
ln -sfn /usr/share/kshare/plugin "$dest"
echo "Linked the KShare plugin to $dest"
echo "Reload it with: omarchy-shell shell rescanPlugins"
echo "Enable it with: omarchy plugin enable kshare.screen"
